# Create a Supabase project, then set these in Vercel Project Settings and local .env.local
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...


# Server-only 32-byte base64 key for encrypting customer platform passwords
PLATFORM_CREDENTIALS_ENCRYPTION_KEY=

# Server-only Instagram Business Login setup; never prefix these with NEXT_PUBLIC_.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://www.delsaai.ir/api/crm/instagram/callback
# Meta app secret used to verify signed webhook deliveries (may differ from Instagram app secret).
INSTAGRAM_WEBHOOK_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Existing Supabase integration provides SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY.

# Zernio (server-only; never paste real keys into commits or chat).
# Rotate any Zernio key that has appeared in a screenshot before configuring.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
# Leave off until the Supabase migration and webhook endpoint are verified.
ZERNIO_CONNECT_ENABLED=false
ZERNIO_ENABLE_WEBHOOK=false
