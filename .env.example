# Create a Supabase project, then set these in Vercel Project Settings and local .env.local
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...


# Server-only 32-byte base64 key for encrypting customer platform passwords
PLATFORM_CREDENTIALS_ENCRYPTION_KEY=
